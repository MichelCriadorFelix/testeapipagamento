# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration for Vercel/Production
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Same Firebase project as the real Sensação Gourmet app (reused for this
# sandbox — same values already set on that app's Vercel project, copy them
# over as-is). Orders here live in a separate 'pix_test_orders' collection
# so nothing here ever touches real order/CRM data.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Mercado Pago Access Token (Painel de Desenvolvedores > Suas integrações >
# Credenciais). Use your own test/sandbox token here to simulate PIX
# payments without touching either real restaurant app.
MERCADOPAGO_ACCESS_TOKEN=

# Same Supabase project as the real app, only needed if testing the product
# photo upload feature too — not required for the PIX payment test itself.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sensacao-gourmet-images
