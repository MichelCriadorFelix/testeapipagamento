rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // The two hardcoded restaurant-owner accounts are allowed to bootstrap
    // themselves as admin on first sign-in; nobody else can self-assign the
    // admin role — every other admin promotion has to go through an
    // existing admin via the `update` rule below.
    function isBootstrapOwnerEmail(email) {
      return email == 'michelgeminicriador@gmail.com' || email == 'felixcastroadv@gmail.com';
    }

    // The two developer accounts that own billing/pause enforcement for
    // this client's app. Their admin role can never be revoked (see the
    // `users/{userId}` update rule), and only they can confirm a payment
    // (settings/billing) or resolve a billing proof — the paying client is
    // an admin themselves and must not be able to grant this to themselves.
    function isBillingAdminEmail(email) {
      return email == 'michelgeminicriador@gmail.com' || email == 'rafaelvitorsantos08@gmail.com';
    }

    // Company-wide settings (name, hours, logo). Everyone can read;
    // only admins can change it — except settingId == 'billing', which is
    // carved out below and excluded here so that more specific rule
    // doesn't get OR'd open by this general one.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && settingId != 'billing';
    }

    // Billing/pause state. Anyone can read it (needed for the customer-
    // facing pause gate) and any admin can create the doc once (bootstrap,
    // harmless either way). Every update after that requires a
    // billing-admin account, so the paying client can never mark their own
    // payment as received or push their due date out.
    match /settings/billing {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isSignedIn() && isBillingAdminEmail(request.auth.token.email);
    }

    // Payment proof submissions. Any admin can attach a proof for
    // themselves; only a billing admin (or the original sender, so the
    // client can see her own submission's status) can read the collection,
    // and only a billing admin can mark one confirmed/edit it.
    match /billingProofs/{proofId} {
      allow read: if isAdmin() &&
        (isOwner(resource.data.senderId) || isBillingAdminEmail(request.auth.token.email));
      allow create: if isAdmin() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isSignedIn() && isBillingAdminEmail(request.auth.token.email);
    }

    // Menu items. Prices/availability must never be writable by customers.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User profiles. Anyone can read/update their own profile, but the
    // `role` field can only ever be changed by an existing admin — this is
    // what stops a customer from self-promoting to admin. `points` is
    // locked the same way, so a customer can't grant themselves loyalty
    // points/rewards directly — only admin-triggered order status changes
    // (approve = debit redeemed points, complete = credit earned points)
    // may touch that field.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        (request.resource.data.role == 'user' ||
         (request.resource.data.role == 'admin' && isBootstrapOwnerEmail(request.resource.data.email)));
      allow update: if ((isOwner(userId) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'points']) ||
          (request.resource.data.role == 'admin' && isBootstrapOwnerEmail(request.resource.data.email)))) || isAdmin()) &&
        !(isBillingAdminEmail(resource.data.email) && request.resource.data.role != 'admin');
      allow delete: if isAdmin() && !isBillingAdminEmail(resource.data.email);
    }

    // Orders. Customers can only create orders for themselves and can only
    // touch the receipt field on their own still-pending order afterwards
    // (e.g. attaching a payment proof) — every other change, including
    // status and total, is admin-only.
    match /orders/{orderId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending_payment' &&
        request.resource.data.total is number &&
        request.resource.data.total > 0;
      allow update: if isAdmin() ||
        (isOwner(resource.data.userId) &&
         resource.data.status == 'pending_payment' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptUrl', 'updatedAt']));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() ||
          isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.userId);
        allow create: if isAdmin() ||
          (isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.userId) &&
           request.resource.data.senderId == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }

    // Financial records — never exposed to customers.
    match /finances/{financeId} {
      allow read, write: if isAdmin();
    }

    // Sandbox collection for testing automated PIX payment confirmation
    // (Mercado Pago) without touching real orders. The webhook that flips
    // status to 'preparing' runs on the Firebase Admin SDK, which bypasses
    // these rules entirely — this only governs the client-side test app.
    match /pix_test_orders/{orderId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending_payment' &&
        request.resource.data.total is number &&
        request.resource.data.total > 0;
      allow update: if isAdmin() ||
        (isOwner(resource.data.userId) &&
         resource.data.status == 'pending_payment' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptUrl', 'updatedAt', 'pixQrCode', 'pixCopiaECola', 'mpPaymentId']));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() ||
          isOwner(get(/databases/$(database)/documents/pix_test_orders/$(orderId)).data.userId);
        allow create: if isAdmin() ||
          (isOwner(get(/databases/$(database)/documents/pix_test_orders/$(orderId)).data.userId) &&
           request.resource.data.senderId == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }
  }
}
